# ローカルで動作確認するときの鍵の雛形。
#
# `cp .env.example .env` して値を埋める。`.env` は gitignore 済みで、
# `make dev` / `make dev-api` が起動時に読む。
#
# ここに並べるのは**鍵と、鍵とセットで要る設定だけ**。変数の一覧と既定値は
# README の「設定」が正本なので、そちらに書いてあるものを写さない。
#
# とくに `ETOKI_DB_PATH` はここに置かない。`make migrate` は make の DB_PATH で
# 渡していて `.env` を読まないため、サーバーだけが別の DB を見て「マイグレーション
# されていない」で起動しなくなる。切り替えたいときは `make migrate DB_PATH=...` と
# 揃える。
#
# 値は shell が解釈する（`set -a; . ./.env`）。空白を含む値はクォートで、
# `$` を含む値は**シングルクォート**で囲む。裸で書くと展開される。

# --- LLM -------------------------------------------------------------------
# 未設定なら解釈のエンドポイントだけが「設定されていない」と返す。
ETOKI_LLM_API_KEY=

# --- GitHub ----------------------------------------------------------------
# PAT と GitHub App は**どちらか一方**。App を設定すると PAT は使われず、
# 代わりにログインを要求する（ADR 0015）。

# PAT で動かす場合。fine-grained なら Metadata: Read-only と
# Projects: Read and write。repo の read が無いとリポジトリ一覧が 0 件になり、
# ボードを作れない。
ETOKI_GITHUB_TOKEN=

# GitHub App でログインさせる場合。3 つとも要る。
# 鍵は `head -c 32 /dev/urandom | base64` で作る。未設定だと起動時に落ちる。
ETOKI_GITHUB_APP_CLIENT_ID=
ETOKI_GITHUB_APP_CLIENT_SECRET=
ETOKI_TOKEN_ENCRYPTION_KEY=

# 認可から戻ってくる先。**オリジンだけ**を書く。`make dev` ならブラウザがいる
# Vite 側のポート。`make start`（dev サーバーを使わない）ではブラウザが :8080 側に
# いるので、http://127.0.0.1:8080 に書き換える。
#
# GitHub App の Callback URL も同じポートに合わせる。ただしあちらは末尾に
# /api/auth/callback が付く（http://127.0.0.1:8080/api/auth/callback）。
ETOKI_PUBLIC_URL=http://127.0.0.1:5173
