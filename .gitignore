# build artifacts
/bin/
/web/dist/
/web/node_modules/
# tsc --noEmit の差分検査用キャッシュ。`make lint` を回すと生成されるので、
# 無視しないと検査しただけで作業ツリーが汚れ、`git add -A` が関係ないコミットに
# 混ぜる（worktree の項と同じ形で #164 から main に入った）。
/web/tsconfig.tsbuildinfo

# e2e の実行結果（レポート・トレース・スクリーンショット）
/web/e2e-output/

# nix
result
result-*
.direnv/

# git worktree（作業ツリーの中に作られる）
# 無視しないと `git add -A` が gitlink として拾い、関係ないコミットに
# 存在しない commit への参照が混ざる。ファイルではなく 1 エントリなので
# 差分を眺めても気づきにくい。
/.claude/worktrees/

# local state
*.db
*.db-shm
*.db-wal
/tmp/
.env
.env.local

# editors
.DS_Store
.idea/
