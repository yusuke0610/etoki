# direnv がこのディレクトリに入ったとき devShell を自動で有効にする。
#
# 素の `use flake` は cd のたびに flake を評価し直すため数秒かかり、しかも
# devShell に GC ルートが張られないので nix-collect-garbage で消える。
# nix-direnv はどちらも解決する。
#
# nix-direnv 自体は自分の flake から取り出す。別途グローバルに入れさせずに
# 済み、バージョンも flake.lock に固定されるため。
if ! has nix_direnv_version; then
  source "$(nix build --no-link --print-out-paths .#nix-direnv)/share/nix-direnv/direnvrc"
fi

use flake

# flake.lock が変わったらキャッシュを作り直す。use flake も監視するが、
# 明示しておかないと lock だけ更新したときに古い環境が残ることがある。
watch_file flake.lock
